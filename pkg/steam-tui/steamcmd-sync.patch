+    /// Reads output until steamcmd prints its "Steam>" prompt again and returns all of it
+    /// (without the prompt). Robust against changes in how steamcmd colours / splits output.
+    pub fn until_prompt(&mut self) -> Result<String, STError> {
+        let mut acc: Vec<u8> = Vec::new();
+        loop {
+            match self.iter.next() {
+                Some(Ok(chunk)) => {
+                    acc.extend_from_slice(&chunk);
+                    acc.push(b'>');
+                    if acc.ends_with(b"Steam>") {
+                        acc.truncate(acc.len() - b"Steam>".len());
+                        return Ok(String::from_utf8_lossy(&acc).into_owned());
+                    }
+                }
+                _ => {
+                    return Err(STError::Problem("steamcmd closed its output".into()));
+                }
+            }
+        }
+    }
 
-        Ok(cmd)
+    /// Runs one command and returns its whole output.
+    pub fn run(&mut self, line: &str) -> Result<String, STError> {
+        self.write(line)?;
