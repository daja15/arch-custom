{
  "manifest_version": 2,
  "name": "Відео поверх вікон",
  "version": "1.3",
  "description": "Відкрити відео зі сторінки в маленькому плеєрі поверх усіх вікон (pip) .",
  "browser_specific_settings": { "gecko": { "id": "pip@desk.local", "strict_min_version": "115.0" } },
  "permissions": ["nativeMessaging", "contextMenus", "tabs", "webRequest", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Відео поверх вікон", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "content_scripts": [{
    "matches": ["<all_urls>"], "all_frames": true, "run_at": "document_idle",
    "js": ["content.js"], "css": ["content.css"]
  }]
}
