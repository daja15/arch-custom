# Тема для aerc — ШАБЛОН: {назва} → колір з ~/.config/theme/theme.conf
# Результат: ~/.config/theme/gen/aerc.styleset (на нього посилається ~/.config/aerc/stylesets/theme)
*.default = true
*.normal  = true

default.fg   = {text}
error.fg     = {red}
error.bold   = true
warning.fg   = {yellow}
success.fg   = {green}

title.fg     = {bg}
title.bg     = {accent}
title.bold   = true
header.fg    = {accent}
header.bold  = true

tab.fg            = {muted}
tab.bg            = {surface}
tab.selected.fg   = {bg}
tab.selected.bg   = {accent}
tab.selected.bold = true
border.fg         = {line}

statusline_default.fg = {muted}
statusline_default.bg = {surface}
statusline_error.fg   = {red}
statusline_success.fg = {green}

# Список листів
msglist_default.fg     = {muted}
msglist_unread.fg      = {text}
msglist_unread.bold    = true
msglist_flagged.fg     = {yellow}
msglist_deleted.fg     = {red}
msglist_marked.bg      = {accent-bg}
msglist_*.selected.bg  = {overlay}
msglist_*.selected.fg  = {text}

# Список папок
dirlist_default.fg     = {muted}
dirlist_unread.fg      = {text}
dirlist_unread.bold    = true
dirlist_*.selected.bg  = {overlay}
dirlist_*.selected.fg  = {accent}
dirlist_*.selected.bold = true

# Підказки й діалоги
completion_default.bg  = {surface}
completion_default.fg  = {text}
completion_*.selected.bg = {overlay}
completion_*.selected.fg = {accent}
selector_default.bg    = {surface}
selector_focused.bg    = {overlay}
selector_focused.fg    = {accent}
selector_chooser.bold  = true
spinner.fg             = {accent}
