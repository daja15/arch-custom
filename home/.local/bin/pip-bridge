#!/usr/bin/env python3
# ╭──────────────────────────────────────────────────────────────╮
# │  PIP-BRIDGE — міст між плагіном Firefox «Відео поверх вікон» │
# │  і плеєром. Firefox запускає його сам (native messaging) і   │
# │  передає { action: "open", url [, referer, ua, page] } —     │
# │  далі pipctl. referer/ua — для потоків зі схованих плеєрів   │
# │  (Kodik тощо): сервер віддає відео лише «своєму» браузеру.   │
# │  Опис для Firefox: ~/.config/mozilla/native-messaging-hosts/ │
# │  pip_bridge.json (його ставить ~/.config/firefox-pip/build.sh)│
# ╰──────────────────────────────────────────────────────────────╯
import json
import os
import struct
import subprocess
import sys
import urllib.parse


def read():
    raw = sys.stdin.buffer.read(4)
    if len(raw) < 4:
        return None
    return json.loads(sys.stdin.buffer.read(struct.unpack("<I", raw)[0]))


def reply(obj):
    data = json.dumps(obj).encode()
    sys.stdout.buffer.write(struct.pack("<I", len(data)) + data)
    sys.stdout.buffer.flush()


def mpv_opts(msg):
    """Параметри mpv для цього відео: «назва=%довжина%значення» — значення з комами не ламаються."""
    opts = {}
    if msg.get("referer"):
        opts["referrer"] = msg["referer"]
        origin = "/".join(msg["referer"].split("/")[:3])
        opts["http-header-fields"] = "Origin: " + origin
    if msg.get("ua"):
        opts["user-agent"] = msg["ua"]
    return ",".join(f"{k}=%{len(v.encode())}%{v}" for k, v in opts.items())


# ───────────── ПРИВ'ЯЗКА ДО ВКЛАДКИ ─────────────
# З watch: true плагін тримає з мостом постійне з'єднання (connectNative). Закрив вкладку,
# перейшов на іншу сторінку чи вийшов з Firefox — з'єднання рветься (або приходить «close»),
# і міст закриває плеєр. Але лише якщо плеєр досі грає САМЕ це відео: нове відео
# (з іншої вкладки чи SUPER+Alt+O) уже замінило його — тоді не чіпаємо.
SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "pip-mpv.sock")
GRACE = 30   # с: стільки плеєр має часу запуститися (yt-dlp розбирає посилання)


def mpv(*cmd):
    """Команда в плеєр (mpv IPC). Відповідь — dict або None, якщо плеєра немає."""
    import socket
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(2)
            s.connect(SOCK)
            s.sendall((json.dumps({"command": list(cmd), "request_id": 1}) + "\n").encode())
            buf = b""
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    return None
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    r = json.loads(line)
                    if r.get("request_id") == 1:
                        return r
    except (OSError, ValueError):
        return None


def watch(url):
    import select
    import time
    start, fd = time.monotonic(), sys.stdin.fileno()
    while True:
        ready, _, _ = select.select([fd], [], [], 3)
        if ready:
            data = os.read(fd, 65536)
            if not data or b'"close"' in data:   # вкладка закрита / інша сторінка / Firefox вийшов
                break
            if b'"forget"' in data:              # відкрито інше відео — цей міст більше не потрібен
                return
        elif time.monotonic() - start > GRACE and mpv("get_property", "pid") is None:
            return                                # плеєр закрили самі — нема за чим стежити
    r = mpv("get_property", "path")
    playing = (r or {}).get("data")
    if playing and playing in (url, urllib.parse.unquote(url[len("file://"):]) if url.startswith("file://") else url):
        mpv("quit")                               # file://… mpv показує як звичайний шлях


msg = read() or {}
url = msg.get("url") or ""
if url.startswith(("http://", "https://", "file://")):
    subprocess.Popen([os.path.expanduser("~/.local/bin/pipctl"), "open", url, mpv_opts(msg), msg.get("page") or url],
                     start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    reply({"ok": True})
    if msg.get("watch"):
        watch(url)
else:
    reply({"ok": False, "error": "немає посилання"})
