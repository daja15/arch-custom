// devstack: дозволити jijau зупиняти docker/containerd без пароля
// (waybar custom/devstack гасить демон після docker compose stop)
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "jijau" &&
        action.lookup("verb") == "stop" &&
        (action.lookup("unit") == "docker.service" ||
         action.lookup("unit") == "containerd.service")) {
        return polkit.Result.YES;
    }
});
